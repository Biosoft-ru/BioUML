<?xml version="1.0" encoding="UTF-8"?>
<plugin>
    <!-- BioUML MCP (Model Context Protocol) service.
         The tool catalog + in-process server live in this OSGi bundle (biouml.plugins.mcp.server.*).
         The HTTP endpoint is an extension servlet (ru.biosoft.server.servlet, prefix "mcp") so it is
         reachable at /biouml/mcp via the OSGi web application's dispatcher (BioUMLLauncher ->
         ConnectionServlet), which runs in the same webapp classloader as the launcher and can resolve
         the SecurityManager session. The servlet class is a plain object (not a javax.servlet subclass)
         so it has no compile-time servlet dependency; ConnectionServlet drives it reflectively. -->
    <extension point="ru.biosoft.server.servlet" id="McpServlet">
        <servlet class="biouml.plugins.mcp.web.McpServlet" prefix="mcp"/>
    </extension>
    <!-- The MCP OAuth 2.1 authorization server (RFC 9728/8414 discovery + authorization-code/PKCE
         flow) so remote MCP clients (Claude.ai custom connectors, etc.) can sign in: it serves the
         well-known metadata at /biouml/oauth/.well-known/... plus /authorize and /token. -->
    <extension point="ru.biosoft.server.servlet" id="McpOAuthServlet">
        <servlet class="biouml.plugins.mcp.oauth.McpOAuthServlet" prefix="oauth"/>
    </extension>
</plugin>

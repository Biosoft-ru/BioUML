<?xml version="1.0" encoding="UTF-8"?>
<plugin>
   <!-- BioUML MCP (Model Context Protocol) service.
        The MCP tool catalog + in-process server live in this OSGi bundle (biouml.plugins.mcp.server.*).
        The bioumlweb webapp's classloader cannot see biouml.plugins.* classes, so the web endpoint is
        the webapp-visible proxy ru.biosoft.server.mcp.McpWebAppServlet, which loads this bundle's
        BioumlMcpServer via ClassLoading.loadClass(name, "biouml.plugins.mcp"). -->
</plugin>

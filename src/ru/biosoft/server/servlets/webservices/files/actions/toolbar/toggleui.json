/*
 * Toggle UI action
 */
{
    id: "toggle_ui",
    label: "Toggle UI mode",
    icon: "icons/toggleui.png",
    visible: "function(doc)
    {
        if(typeof isGEPerspective === 'function' && isGEPerspective(perspective) )
        {
            return -1;
        }
        return true;
    }",
    action: "function(event)
    {
        toggleUI();
    }"
}